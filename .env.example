PORT=3000
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Comma-separated list of allowed admin panel origins.
# Use your deployed admin URL after Railway creates it, for example:
# CORS_ORIGIN=https://your-admin-service.up.railway.app
CORS_ORIGIN=http://localhost:5173

# S3 upload configuration.
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
S3_REGION=ap-south-1
S3_BUCKET_NAME=scam-awareness-project

# Optional Firebase notification configuration.
# For Railway, prefer FIREBASE_SERVICE_ACCOUNT_JSON and paste the full service
# account JSON into the Railway variable value.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# For local development, you can use a file path instead.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./src/config/serviceAccountKey.json
